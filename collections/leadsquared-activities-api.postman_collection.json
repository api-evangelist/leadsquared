          "name": "Post an activity on a lead",
          "request": {
            "name": "Post an activity on a lead",
            "description": {
              "content": "Create a custom activity event against a lead. The\nRelatedProspectId identifies the lead, ActivityEvent is the\nconfigured event code.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "ProspectActivity.svc",
                "Create"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your region-specific API host (see https://apidocs.leadsquared.com/api-host/)",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"RelatedProspectId\": \"<string>\",\n  \"ActivityEvent\": \"<integer>\",\n  \"ActivityNote\": \"<string>\",\n  \"ProcessFilesAsync\": \"<boolean>\",\n  \"ActivityDateTime\": \"<string>\",\n  \"Fields\": [\n    {\n      \"SchemaName\": \"<string>\",\n      \"Value\": \"<string>\"\n    },\n    {\n      \"SchemaName\": \"<string>\",\n      \"Value\": \"<string>\"\n    }\n  ]\n}",
